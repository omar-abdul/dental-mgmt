  "validation_rules": {
    "patient_required_fields": ["first_name", "last_name", "date_of_birth", "phone"],
    "appointment_required_fields": ["patient_id", "dentist_id", "date", "start_time", "status"],
    "invoice_required_fields": ["patient_id", "invoice_date", "items"],
    "payment_required_fields": ["invoice_id", "amount", "payment_method", "payment_date"]
