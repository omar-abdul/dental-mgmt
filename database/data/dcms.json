    "id_formats": {
      "patient": "PAT-{YYYY}-{#####}",
      "appointment": "APT-{YYYY}-{#####}",
      "encounter": "ENC-{YYYY}-{#####}",
      "invoice": "INV-{YYYY}-{#####}",
      "receipt": "RCT-{YYYY}-{#####}",
      "payment": "PAY-{YYYY}-{#####}",
      "prescription": "RX-{YYYY}-{#####}",
      "lab_order": "LAB-{YYYY}-{#####}",
      "purchase_order": "PO-{YYYY}-{#####}"
    },
    "clinical": {
      "tooth_numbering_system": "FDI",
      "default_note_format": "SOAP",
      "allow_draft_notes": true,
      "require_clinician_signoff": true,
      "lock_signed_clinical_records": true
    },
    "billing": {
      "currency": "USD",
      "decimal_places": 2,
      "allow_partial_payments": true,
      "allow_payment_over_invoice": false,
      "require_reference_for_electronic_payments": true,
      "invoice_due_days": 0,
      "tax_enabled": true,
      "discount_authorization_required": true,
      "refund_authorization_required": true,
      "daily_cash_reconciliation_required": true,
      "mobile_money": {
        "enabled": true,
        "providers": ["zaad", "sahal", "edahab", "mycash"],
        "require_phone_number": true,
        "require_transaction_reference": true,
        "require_transaction_id": true,
        "prevent_duplicate_transaction_id": true,
        "allow_manual_verification": true,
        "reconciliation_required": true
      }
    },
    "inventory": {
      "negative_stock_allowed": false,
      "batch_tracking": true,
      "expiry_tracking": true,
      "low_stock_alerts": true,
      "stock_adjustment_authorization_required": true
    },
    "notifications": {
      "appointment_reminder_hours": [48, 24, 2],
      "channels": ["SMS", "email", "WhatsApp", "in_app"],
      "retry_attempts": 3
    },
    "privacy": {
      "audit_all_patient_record_access": true,
      "encrypt_sensitive_data_at_rest": true,
      "encrypt_data_in_transit": true,
      "automatic_logout_minutes": 30,
      "minimum_password_length": 10
    }
  },
  "audit_logs": [],
  "backup": {
    "enabled": true,
    "frequency": "daily",
    "retention_days": 30
